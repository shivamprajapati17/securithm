{
  "name": "securithm",
  "version": "1.0.1",
  "description": "Securithm SDK + CLI — Ship secure contracts. Scan & auto-fix Solidity from the terminal (securithm scan Contract.sol --fix), or integrate via the typed client.",
  "keywords": [
    "securithm",
    "smart-contract",
    "security",
    "solidity",
    "audit",
    "blockchain",
    "ethereum",
    "solana",
    "web3",
    "smart-contract-audit",
    "smart-contract-security"
  ],
  "homepage": "https://github.com/shivamprajapati17/securithm#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shivamprajapati17/securithm.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/shivamprajapati17/securithm/issues"
  },
  "license": "MIT",
  "author": "Shivam Prajapati <shivamprajapati17>",
  "type": "module",
  "bin": {
    "securithm": "./dist/cli.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./engine": {
      "import": {
        "types": "./dist/engine.d.ts",
        "default": "./dist/engine.js"
      },
      "require": {
        "types": "./dist/engine.d.cts",
        "default": "./dist/engine.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts src/engine.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts src/engine.ts --format esm,cjs --dts --watch",
    "prepublishOnly": "npm run build",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
